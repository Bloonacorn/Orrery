                    print("That isn't a number.")
                continue

    first = False
    g=a
    for g in range(g):
        print(f"Card {g+1}: {finishedDeck[g]}")
    g=a
    for g in range(g):
        b = finishedDeck[0]
        discard.append(b)
        del finishedDeck[0]
    
    print(f"\n{len(finishedDeck)} cards remaining.")
             
    if a == (len(tarotDeck)) and kind == "Tarot":
        print("\nGood luck divining the entire deck, smartass.")
        
    elif a == (len(tarotDeck)) and kind == "Playing":
        print(f"\nY'know, {len(tarotDeck)} pickup isn't really playable on pc.")
        
