def makeMares():
    while True:
        w = input("How many names do you want?\n")
        try:
            w = int(w)
            break
        except:
            print("Only currently accepts whole numbers. 1, 2, 3, etc.")
            continue
    
    for w in range(w):
        a = randint (0, len(firstNames) -1)
        a = firstNames[a]
        a = a.capitalize()
        
        b = randint (0, len(lastNames) -1)
        b = lastNames[b]
        b = b.capitalize()
        
        c = randint (1, 20)
        d = randint (1, 20)
        
        e = randint (0, len(titles) -1)
        e = titles[e]
        e = e.capitalize()
        
        f = randint (0, len(trailing) -1)
        f = trailing[f]
        
        decideColor = randint (0, len(colors) -1)
        decideColor = colors[decideColor]
        
        coronate = randint (1, 30)
        if coronate == 30:
            decideTribe = "Alicorn"
        elif coronate < 30 and coronate >= 25: # I intend this to be 25-29
            decideTribe = randint (0, len(exoticTribe) -1)
            decideTribe = exoticTribe[decideTribe]
        else:
            decideTribe = randint (0, len(tribe) -1)
            decideTribe = tribe[decideTribe]
            
        gay2bgay = randint (0, 21)
        if gay2bgay == 21:
            decideSex = "futa-mare"
        else:
            decideSex = randint (0, len(sex) -1)
            decideSex = sex[decideSex]
        
        if c == 20 and d == 20:
            cuteMares.append(f"{e} {a} {b} {f}, the {decideColor} {decideTribe} {decideSex}")
        elif d == 20:
            cuteMares.append(f"{e} {a} {b}, the {decideColor} {decideTribe} {decideSex}")
        elif c == 20:
            cuteMares.append(f"{a} {b} {f}, the {decideColor} {decideTribe} {decideSex}")
        else:
            cuteMares.append(f"{a} {b}, the {decideColor} {decideTribe} {decideSex}")
    
    for x in range(len(cuteMares)):
        print(f"Pony {x+1}: {cuteMares[x]}")
        
