            keepGoing = True
            del cuteMares[:]
            break
        elif isinstance (a, str) and a.lower() in disagree:
            b = input("Alright, later then.\n(Input any value to close program)")
            keepGoing = False
            break
        else:
            print("Has to be a yes or no.")
            continue

def master():
    while True:
        if keepGoing == True:
            makeMares()
            dontForget()
        else:
            break
    
