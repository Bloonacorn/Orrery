def makeMares():
    while True:
        w = input("How many names do you want?\n")
        try:
            w = int(w)
            break
        except:
            print("Only currently accepts whole numbers. 1, 2, 3, etc.")
            continue
    
    for w in range(w):
        a = randint (0, len(firstNames) -1)
        a = firstNames[a]
        a = a.capitalize()
        
        b = randint (0, len(lastNames) -1)
        b = lastNames[b]
        b = b.capitalize()
        
        c = randint (1, 30)
        d = randint (1, 30)
        
        e = randint (0, len(titles) -1)
        e = titles[e]
        e = e.capitalize()
        
        f = randint (0, len(trailing) -1)
        f = trailing[f]
        
        if c == 30 and d == 30:
            cuteMares.append(f"{e} {a} {b} {f}")
        elif d == 30:
            cuteMares.append(f"{e} {a} {b}")
        elif c == 30:
            cuteMares.append(f"{a} {b} {f}")
        else:
            cuteMares.append(f"{a} {b}")
    
    for x in range(len(cuteMares)):
        print(f"Mare {x+1}: {cuteMares[x]}")
        
