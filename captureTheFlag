# Helper function for user input error handling
def translate(a):
    try:
        a = int(a)
    except:
        pass
    if isinstance(a, str) and a.lower() in compass:
        babble		= a.lower()
        evilBabble	= compass[babble]
        a	= int(evilBabble)
    return a

