    while True:
        a = input("Would you like to play again?\n")
        if a in agree:
            print("Alright, regenerating the map.\n")
            replay = True
            victory = False
            defeat = False
            break
        elif a in disagree:
            replay = False
            break
        else:
            print("Didn't quite catch that.\n")
            
