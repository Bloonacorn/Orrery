def topsoil(ver, hor):
    for x in range (ver):
        for y in range (hor):
            a = randint(0,1)
            if a == 1:
                board[x][y] = ","
                ground[x][y] = ","
            else:
                board[x][y] = "."
                ground[x][y] = "."   

# This function populates the map with game objects
def spawn(ver, hor):
    global you, flag, enemy, forest
    
    symbols = ["T", "⚑", "\033[38;2;40;149;253m♞\033[0m", "\033[1;37m@\033[0m", "B", "C", "\033[1;37mA\033[0m"]
    flagless = ["T", "\033[1;37m@\033[0m", "B", "C", "\033[1;37mA\033[0m"] # cannot contain "F" or "\033[38;2;40;149;253m♞\033[0m"
    
    while True:
        # You
        while True:
            a = randint(0,ver-1)
            b = randint(0,hor-1)
            
            if board[a][b] not in symbols:
                board[a][b] = "\033[1;37m@\033[0m"
                you.append(a)
                you.append(b)
                break
        # Flag
        while True:
            a = randint(0,ver-1)
            b = randint(0,hor-1)
            
            if board[a][b] not in symbols:
                board[a][b] = "⚑"
                ground[a][b] = "⚑" # I'm considering making it possible for enemies to walk over the flag, might not, could softlock.
                flag.append(a)
                flag.append(b)
                break
        # Trees
        t = 0
        while t != trees:
            a = randint(0,ver-1)
            b = randint(0,hor-1)
            
            if board[a][b] not in symbols:
                board[a][b] = "T"
                ground[a][b] = "T"
                forest.append([a,b])
                t += 1
        # John B. Treyl
        while True:
            a = randint(0,ver-1)
            b = randint(0,hor-1)
            
            if board[a][b] not in symbols:
                board[a][b] = "\033[38;2;40;149;253m♞\033[0m"
                enemy.append(a)
                enemy.append(b)
                break
        # Doppelganger
        while True:
            a = randint(0,ver-1)
            b = randint(0,hor-1)
            
            if board[a][b] not in symbols:
                board[a][b] = "\033[1;37mA\033[0m"
                twoman.append(a)
                twoman.append(b)
                break
            
        #######################################################
        # SOFTLOCK CHECK:
        #
        # Part 1: Use pathfinding code to detect path from "F" to "\033[1;37m@\033[0m" and from "\033[38;2;40;149;253m♞\033[0m" to "\033[1;37m@\033[0m".
        # Part 2: If either path fails to generate, regenerate map and recheck.
        
        pathfinder = [[-1 for _ in range(hor)] for _ in range(ver)] # temp list of lists, used for pathfinding
        
        urslf = [] # clone of player pos
        urslf.append(you[:])
        
        goal  = [] # clone of flag pos
        goal.append(flag[:])
        
        john  = [] # clone of enemy pos
        john.append(enemy[:])
        
        # I'm not sure if these cloned values are actually worth having
        # I think they're redundancies, might remove them.
        
        pathfinder[you[0]][you[1]] = 0 # placing 0 at player pos
        
        # north, east, west, south
        directions = [[-1, 0], [0, 1], [0, -1], [1, 0]]
        
        while len(urslf) > 0: 
            current = urslf.pop(0) # .pop() removes an entry from a list and returns it
            row = current[0]
            col = current[1]
            rings = pathfinder[row][col]
            
            for d in directions:
                nr = row + d[0] # new row
                nc = col + d[1] # new column
                
                # IMPORTANT: Unlike in chase(), we don't want the flag's position to be -1!
                if (0 <= nr < ver) and (0 <= nc < hor) and pathfinder[nr][nc] == -1 and board[nr][nc] not in flagless:
                    pathfinder[nr][nc] = rings + 1
                    urslf.append([nr,nc])

        j_dist = pathfinder[enemy[0]][enemy[1]]
        j_dist = int(j_dist)
        
        f_dist = pathfinder[flag[0]][flag[1]]
        f_dist = int(f_dist)
        
        if j_dist > 0 and f_dist > 0:
            break
        else:
            del you[:]
            del flag[:]
            del enemy[:]
            del board[:][:]
            del ground[:][:]
            del forest[:]
            del twoman[:]
            
            topsoil(a,b)
            detectLen(a,b)
            adjust(a,b,c)
    

def translate(a):
    try:
        a = int(a)
    except:
        pass
    if isinstance(a, str) and a.lower() in compass:
        babble		= a.lower()
        evilBabble	= compass[babble]
        a	= int(evilBabble)
    return a

