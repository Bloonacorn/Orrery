# Fills empty spaces with ","s and "."s
# Really just an aesthetic feature.
def topsoil(ver, hor):
    for x in range (ver):
        for y in range (hor):
            a = randint(0,1)
            if a == 1:
                board[x][y] = ","
                ground[x][y] = ","
            else:
                board[x][y] = "."
                ground[x][y] = "."   

# A helper function to reduce the size of spawn(), its very repetative.
def summon(ver, hor, symb, sol):
    symbols = ["T", "⚑", "\033[38;2;40;149;253m♞\033[0m", "\033[1;37m@\033[0m", "♛", "C", "\033[1;37mA\033[0m", "#", "╍", "▒", "╏"]
    
    while True:
