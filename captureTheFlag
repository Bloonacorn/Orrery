def adjust(ver, hor, area):
    for h in range(ver):
        for i in range(hor):
            value 		= board[h][i]
            square		= value
            square = str(square)
            list(square)
            space		= area - len(square)
            square = "".join(square)
            y = (" " * space, square)
            y = "".join(y)
            respace.append(y)
            squareSpace	= respace[i]
            board[h][i] = squareSpace
        del respace[:]

