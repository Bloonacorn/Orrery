# function to allow the enemy to chase the player
def chase(ver, hor, forest_trees):
    global enemy, defeat, you, j_dist, john_rest, john_tail

    # Step 1: Create ring map relative to enemy position.
    # Step 2: Create list of coordinates that lead from player position to enemy position
    # Step 3: Have enemy move to space marked at the end of list of coordinates

    #####################################################################
    # Enemy Chasing Behavior - Part 1: Ring Map Generation        

    pathfinder = [[-1 for _ in range(hor)] for _ in range(ver)] # temp list of lists, used for pathfinding
    explore = [] # list for holding copy of enemy position
    explore.append(enemy[:]) # filling list
    pathfinder[enemy[0]][enemy[1]] = 0 # placing 0 at enemy pos
    
    # north, east, west, south
    directions = [[-1, 0], [0, 1], [0, -1], [1, 0]]
    
    while len(explore) > 0: 
        current = explore.pop(0) # .pop() removes an entry from a list and returns it
        row = current[0]
        col = current[1]
        rings = pathfinder[row][col]
        
        for d in directions:
            nr = row + d[0] # new row
            nc = col + d[1] # new column
            
            if (0 <= nr < ver) and (0 <= nc < hor) and pathfinder[nr][nc] == -1 and board[nr][nc] != "T" and board[nr][nc] != "F":
                pathfinder[nr][nc] = rings + 1
                explore.append([nr,nc])
        
    #####################################################################
    # Enemy Chasing Behavior - Part 2: Path from "\033[1;37m@\033[0m" to "\033[38;2;40;149;253m♞\033[0m"
    # God pathfinding is hell to write
        
    ppos = [] # player position
    for _ in range(len(you)):
        ppos.append(you[_])
    row = ppos[0]
    col = ppos[1]
    
    path = [] # pathing from player to enemy
    path.append([ppos[0], ppos[1]]) # append initial player position (necessary to start loop)
    
    j_dist = pathfinder[you[0]][you[1]] # the number that is in this position on pathfinder is what i want
    j_dist = int(j_dist)
    
    for _ in range(j_dist):
        counter = 0 # simply prevents it from writing more then one valid lower position.
        row = path[_][0] # SOME FUCKING HOW THIS CREATED AN INDEX ERROR AAAAAAAAAAAAAAAAAAAAAAAA
        col = path[_][1]
        
        for d in directions:
            symbols = ["T", "⚑", "\033[38;2;40;149;253m♞\033[0m", "\033[1;37mA\033[0m", "B", "C"]

            nr = row + d[0] # new row
            nc = col + d[1] # new column
            
            if (0 <= nr < ver) and (0 <= nc < hor):
                chk_rng = pathfinder[nr][nc] # ring number of neighbor being checked
                old_pos = pathfinder[path[-1][0]][path[-1][1]] # old position
                
                if (0 <= nr < ver) and (0 <= nc < hor) and chk_rng == old_pos - 1 and board[nr][nc] not in symbols and counter == 0:
                    path.append([nr, nc])
                    counter += 1
                
    #####################################################################
    # Enemy Chasing Behavior - Part 3: Enemy Movement
    
    target_row = path[-1][0] # -1 in a list index picks the last entry of the list.
    target_col = path[-1][1]

    current_row = enemy[0]
    current_col = enemy[1]
    
    under = ground[current_row][current_col]
    
    # John B. Treyl has a tendency to eventually end up stuck to the players ass
    # to counteract this behavior, if he remains stuck to you for 5 turns, he will
    # rest for 3. Untested.
    if john_tail < 5:
        if target_row == current_row - 1: # North
            enemyNorth(current_row, current_col, under)
            if j_dist == 1:
                john_tail += 1
            
        if target_row == current_row + 1: # South
            enemySouth(current_row, current_col, under)
            if j_dist == 1:
                john_tail += 1
            
        if target_col == current_col + 1: # East
            enemyEast(current_row, current_col, under)
            if j_dist == 0:
                john_tail += 1
            
        if target_col == current_col - 1: # West
            enemyWest(current_row, current_col, under)
            if j_dist == 0:
                john_tail += 1
            
        if len(path) == 0 or pathfinder[you[0]][you[1]] == -1: # accounting for the possibility that johns unable to move to player
